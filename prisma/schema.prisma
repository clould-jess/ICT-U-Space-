generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  password          String
  role              String        // "STUDENT", "PREFECT", "LECTURER", "ADMIN"
  matricule         String?       @unique  // "ICTULEC..." for lecturers, "ICTU..." for students
  push_subscription String?
  academic_level    String?
  semester          String?
  major             String?       // department code e.g. "ICT", "ACC", "BMS"
  booking_key       String?       @unique

  coursesTaught     Course[]      @relation("LecturerCourses")
  coursesDelegated  Course[]      @relation("CourseDelegate")
  enrolledIn        Course[]      @relation("StudentEnrollments")
  reservations      Reservation[] @relation("UserReservations")
  sentMessages      Message[]     @relation("SentMessages")
  receivedMessages  Message[]     @relation("ReceivedMessages")
}

model Hall {
  id             String           @id @default(cuid())
  name           String           @unique
  capacity       Int
  features       String
  building_block String

  timetable      TimetableEntry[]
  reservations   Reservation[]
}

model Course {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  enrolled_count Int

  lecturer_id    String?
  lecturer       User?            @relation("LecturerCourses", fields: [lecturer_id], references: [id], onDelete: SetNull)

  delegate_id    String?
  delegate       User?            @relation("CourseDelegate", fields: [delegate_id], references: [id], onDelete: SetNull)

  timetable      TimetableEntry[]
  reservations   Reservation[]
  notifications  Notification[]
  students       User[]           @relation("StudentEnrollments")
}

model Notification {
  id         String   @id @default(cuid())
  message    String
  created_at DateTime @default(now())

  course_id  String
  course     Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
}

model TimetableEntry {
  id          String @id @default(cuid())
  day_of_week String
  start_time  String
  end_time    String

  course_id   String
  course      Course @relation(fields: [course_id], references: [id])

  hall_id     String
  hall        Hall   @relation(fields: [hall_id], references: [id])
}

model Reservation {
  id         String  @id @default(cuid())
  date       String
  start_time String
  end_time   String
  status     String  // "CONFIRMED", "CANCELED"
  type       String  @default("CLASS") // "CLASS", "EVENT"
  event_name String?

  hall_id    String
  hall       Hall    @relation(fields: [hall_id], references: [id])

  course_id  String?
  course     Course? @relation(fields: [course_id], references: [id])

  reserved_by String
  user        User    @relation("UserReservations", fields: [reserved_by], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  created_at  DateTime @default(now())

  sender_id   String
  sender      User     @relation("SentMessages", fields: [sender_id], references: [id])

  receiver_id String?
  receiver    User?    @relation("ReceivedMessages", fields: [receiver_id], references: [id])
}
