generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         String        // "STUDENT", "PREFECT", "LECTURER", "ADMIN"
  push_subscription String?  // Stores stringified Web Push subscription object
  academic_level String?     // e.g., "Level 1", "Level 2"
  semester       String?     // e.g., "Fall26"
  
  coursesTaught Course[]      @relation("LecturerCourses")
  enrolledIn   Course[]      @relation("StudentEnrollments")
  reservations Reservation[] @relation("UserReservations")
  sentMessages Message[]     @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Hall {
  id             String           @id @default(cuid())
  name           String           @unique
  capacity       Int
  features       String           // Stored as comma-separated string, e.g., "projector,AC"
  building_block String

  timetable      TimetableEntry[]
  reservations   Reservation[]
}

model Course {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  enrolled_count   Int
  
  lecturer_id      String
  lecturer         User             @relation("LecturerCourses", fields: [lecturer_id], references: [id])
  
  timetable        TimetableEntry[]
  reservations     Reservation[]
  notifications    Notification[]
  students         User[]           @relation("StudentEnrollments")
}

model Notification {
  id          String   @id @default(cuid())
  message     String
  created_at  DateTime @default(now())
  
  course_id   String
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
}

model TimetableEntry {
  id          String   @id @default(cuid())
  day_of_week String   // "Monday", "Tuesday", etc.
  start_time  String   // "09:00"
  end_time    String   // "11:00"

  course_id   String
  course      Course   @relation(fields: [course_id], references: [id])
  
  hall_id     String
  hall        Hall     @relation(fields: [hall_id], references: [id])
}

model Reservation {
  id          String   @id @default(cuid())
  date        String   // "YYYY-MM-DD"
  start_time  String   // "09:00"
  end_time    String   // "11:00"
  status      String   // "CONFIRMED", "CANCELED"

  hall_id     String
  hall        Hall     @relation(fields: [hall_id], references: [id])
  
  course_id   String?
  course      Course?  @relation(fields: [course_id], references: [id])
  
  reserved_by String
  user        User     @relation("UserReservations", fields: [reserved_by], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  created_at  DateTime @default(now())
  
  sender_id   String
  sender      User     @relation("SentMessages", fields: [sender_id], references: [id])
  
  receiver_id String?  // Optional receiver for direct messages
  receiver    User?    @relation("ReceivedMessages", fields: [receiver_id], references: [id])
}
